% Carregamento condicional do Font Awesome para ícones
% Tenta fontawesome5, depois fontawesome (v4). Se nenhum disponível, define \alerticon via TikZ.
\IfFileExists{fontawesome5.sty}{%
    \PackageInfo{apostila}{fontawesome5 encontrado: usando \string\faIcon{exclamation-triangle}}%
    \RequirePackage{fontawesome5}%
    % usa interface fontawesome5 (\faIcon{<name>}) para ícones
    \newcommand{\alerticon}{\faIcon{exclamation-triangle}}%
}{%
    \IfFileExists{fontawesome.sty}{%
        \PackageInfo{apostila}{fontawesome (v4) encontrado: usando \string\faExclamationTriangle}%
        \RequirePackage{fontawesome}%
        \newcommand{\alerticon}{\faExclamationTriangle}%
    }{%
        % fallback: pequeno ícone desenhado com TikZ
        \PackageInfo{apostila}{Nenhum pacote FontAwesome encontrado: usando ícone TikZ como fallback}%
        \newcommand{\alerticon}{% 
            \tikz[baseline=-0.6ex]{\node[draw=secondaryColor!55,fill=secondaryColor!70,rounded corners=1pt,inner sep=1pt]{\textcolor{black}{\small\textbf{!}}};}%
        }%
