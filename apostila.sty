% --- Formatação das legendas: usa a família OPOSTA em relação à família principal ---
% Mover para \AtBeginDocument para evitar problemas de expansão durante o carregamento.
% Simplified captions setup to avoid preamble expansion issues.
% Temporarily force a small caption font; the opposite-family logic
% can be restored once the root cause of the stack overflow is found.
\AtBeginDocument{%
    % Restaurar a lógica de usar a família OPOSTA nas legendas de forma segura
    % Usar os nomes de fonte reconhecidos pelo pacote `caption` (rm / sf)
    \if@apostila@roman
        \captionsetup{font={small,sf}}%
        % Definir macro usada por \source para seguir a mesma fonte das captions
        \gdef\apostila@captionfont{\small\sffamily}%
    \else
        \captionsetup{font={small,rm}}%
        % Definir macro usada por \source para seguir a mesma fonte das captions
        \gdef\apostila@captionfont{\small\rmfamily}%
    \fi
}

% Define um novo tcolorbox para o sumário
\newtcolorbox{sumariobox}[1][]{%
    enhanced,
    breakable,
    colback=secondaryColor!20,
    colframe=white,
    sharp corners,
    fonttitle=\bfseries,
    coltitle=primaryColor,      % <-- Cor da fonte alterada para primaryColor
    colbacktitle=white,      % <-- Cor de fundo do título definida como branco
    % ====================================================================
    #1
}

% --- Novo ambiente: alertbox ---
% Uso: \begin{alertbox}[<tcolor options>]{<Título opcional>} ... \end{alertbox}
% Se o título não for fornecido (ou se {} for usado), usa \apostila@alertboxtitlename.
% IMPORTANTE: O título opcional usa chaves {}. As opções do tcolorbox vão entre colchetes [].
% Exemplo com título padrão: \begin{alertbox} ... \end{alertbox}
% Exemplo com título customizado: \begin{alertbox}{Cuidado!} ... \end{alertbox}
\NewDocumentEnvironment{alertbox}{ O{} g }
{%
    % #1 = opções do tcolorbox (opcional, entre colchetes)
    % #2 = título opcional (entre chaves). Se ausente, será \apostila@alertboxtitlename
    \begin{tcolorbox}[enhanced,breakable,
            colback=accentColor!20,
            colframe=accentColor!55,
            arc=3pt,boxrule=0.8pt,
            left=6pt,right=6pt,top=6pt,bottom=6pt,
            fonttitle=\bfseries,
            before skip=6pt,after skip=6pt,
            title={% título com ícone
                    \begin{tikzpicture}[baseline=(t.base)]
                        \node[inner sep=0pt, text=black] (icon) {\alerticon};
                        \node[anchor=west, text=black] (t) at ($(icon.east)+(4pt,0)$)
                        {\IfNoValueTF{#2}{\apostila@alertboxtitlename}{#2}};
                    \end{tikzpicture}
                },
            #1]
        }
        {\end{tcolorbox}}

\newtcolorbox{infobox}[1][]{%
    enhanced,
    breakable,                % Permite que a caixa quebre entre páginas
    colback=secondaryAccentColor!20,  % Cor de fundo definida como secondaryColor
    colframe=secondaryAccentColor!20, % Cor da borda igual ao fundo
    sharp corners,            % Define as bordas como retas (90 graus)
    % A opção 'title' foi removida para não ter título.
    #1
}

\newtcolorbox{remarkbox}[1][]{%
    enhanced,
    breakable,
    colback=primaryColor!20,
    colframe=primaryColor!20,
    sharp corners,
    % A opção 'title' foi removida para não ter título.
    #1
}

% Define o estilo do sumário para usar o novo tcolorbox
\etocsettocstyle{%
    \etocfontminusone{\Huge\contentsname}\normalfont\normalsize
    \begin{sumariobox}}{\end{sumariobox}}


\newcommand*\chaptertoc{%
    \begingroup
    \normalfont
    % Removemos as configurações de cor daqui, pois a 'sumariobox' já as controla.

    % A lógica agora está toda dentro do \etocsettocstyle
    \etocsettocstyle
    {% --- CÓDIGO-ANTES ---
        % Este bloco é executado QUANDO o \localtoc começa.
        % 1. Verifica se o sumário local do capítulo está vazio.
        \etocchecksemptiness
        % 2. Se NÃO estiver vazio, abre a caixa colorida e imprime o título.
        \etocifwasempty
        {} % Se estiver vazio, não faz nada.
        {% Se NÃO estiver vazio:
            \begin{sumariobox}[title=\apostila@chapternotes]
                }%
                }
                {% --- CÓDIGO-DEPOIS ---
                % Este bloco é executado QUANDO o \localtoc termina.
                % 1. Verifica novamente (o estado não mudou).
                \etocifwasempty
                {} % Se estava vazio, não faz nada.
                {\end{sumariobox}}% Se NÃO estava vazio, fecha a caixa.
    }

    % Agora, este comando simplesmente executa o estilo que acabamos de definir.
    \localtableofcontentswithrelativedepth{+2}
    \endgroup
}%

% --- Capa, página de título e página de informações ---
\renewcommand{\maketitle}{%
    \thispagestyle{empty}
    \pdfbookmark[0]{\apostila@covername}{capa}
    \begin{tikzpicture}[overlay, remember picture, ampersand replacement=\&]
        \node[inner sep=0] at (current page.center) {\includegraphics[width=\paperwidth,height=\paperheight]{\@coverimage}};
        \node[color=secondaryColor] (institute) at ($(current page.north) + (0,-1.5cm)$)
        {\begin{varwidth}{\paperwidth}\centering\linespread{1.0}\Large\@institute\end{varwidth}};
        \node[anchor=center] (illustration) at ($(current page.center)+(0,3.5cm)$)
        {\includegraphics[width=0.8\paperwidth]{\@coverillustration}};
        \node[
            anchor=north,
            font=\fontsize{30}{28}\bfseries\titulocapitulo\selectfont,
            text=primaryColor,
            text width=0.9\paperwidth,
            align=center,
        ] (title) at ($(illustration.south)+(0,-.5cm)$) {\@title};
        \node[text=primaryColor, below=.25cm of title, font=\fontsize{25}{30}\selectfont] (subtitle)  {\@subtitle};
        \node[text=primaryColor, below=.25cm of subtitle] (author)  {\Large \@author};
        \node [matrix of nodes, nodes={inner sep=5pt}] (my matrix) at ($(current page.south)+(0,2cm)$)
        {
            \includegraphics[width=3cm]{\@robsicsymbol} \& \includegraphics[width=2cm]{\@unifeisymbol} \\
        };
    \end{tikzpicture}
    \clearpage\thispagestyle{empty}
    % --- Página de título ---
    \begin{titlepage}\thispagestyle{empty}
        \pdfbookmark[0]{\apostila@titlepagename}{titulo}
        \begin{flushright}
            \rule{\linewidth}{0.4mm}\\[3pt]
            % Uso de minipage + \raggedleft e \sloppy para permitir quebras
            % de linha mais flexíveis e reduzir Underfull \hbox em títulos longos.
            \tikz \node[text width=\textwidth-1cm, align=right, inner xsep=.5cm]
            {\begin{minipage}{\textwidth-1cm}\raggedleft\sloppy
                    {\fontsize{28}{34}\scshape\selectfont\@title}\par\vspace{10pt}
                    {\fontsize{22}{30}\selectfont\@subtitle}\par\vspace{10pt}
                    {\fontsize{18}{26}\selectfont\@author}\par
                \end{minipage}};
            \vspace{3cm}
            \rule{\linewidth}{0.4mm}\\[3pt]
        \end{flushright}
        \vfill
        \begin{center}\includegraphics[width=8cm]{\@robsichorizcompl}\end{center}
        \begin{center}\includegraphics[width=8cm]{\@unifeihorizcompl}\end{center}
    \end{titlepage}
    % --- Página de informações ---
    \clearpage\thispagestyle{empty}\vspace*{-1cm}
    \pdfbookmark[0]{\apostila@infopagename}{info}
    {\bfseries\LARGE\@title}\par\vspace{1cm}
    Versão: \@version\par\vspace{1cm}
    Data da compilação: \today\par\vspace{1cm}
    Copyright \textcopyright~\the\year~dos autores. Todos os direitos reservados.\par\vspace{1.5cm}
    \tikz \node[fill=primaryColor!20, text width=0.9\textwidth, inner sep=10pt, align=left]
    {\apostila@sourcecodetext\par\url{\@repositoryurl}\par\vspace{1em}\@extrainfo};
    \vfill
    \begin{tikzpicture}[overlay, remember picture]
        \node[anchor=south, fill=black!20, text width=\textwidth, align=left, inner ysep=10pt, inner xsep=10pt] at ($(current page.south) + (0, 3cm)$) {\doclicenseThis};
    \end{tikzpicture}
    \clearpage
}%
% --- FIM DA DEFINIÇÃO DE CAPA, PÁGINA DE TÍTULO E PÁGINA DE INFORMAÇÕES ---

% --- Comando para desenhar a contracapa ---
\newcommand{\maketitleback}{%
    % Verifica se o modo twoside está ativo.
    \if@twoside
        % Se sim, garante que a próxima página seja par.
        % Se a página atual for ímpar, insere uma página em branco.
        \clearpage
        \ifodd\c@page
            \hbox{}\thispagestyle{empty}\newpage
        \fi
    \else
        % Se não, apenas começa uma nova página normalmente.
        \clearpage
    \fi
    % Desenha a contracapa
    \thispagestyle{empty}%
    \pdfbookmark[0]{\apostila@backcovername}{contracapa}%
    \begin{tikzpicture}[overlay, remember picture]
        \fill[secondaryColor] (current page.south west) rectangle ($(current page.south east) + (0, 4cm)$);
        \fill[primaryColor] (current page.north west) rectangle ($(current page.north east) + (0, -4cm)$);
        \node[matrix of nodes, nodes={inner sep=5pt}] (matrix) at (current page.center)
        {
            \includegraphics[width=10cm]{\@unifeihorizcompl} \\
            \includegraphics[width=10cm]{\@robsichorizcompl} \\
        };
        \node[text width=\paperwidth, align=center, text=primaryColor] at ($(current page.south) + (0, 2cm)$) {
            \Large\@institute \\
            \normalsize\url{\@website}
        };
    \end{tikzpicture}%
    \clearpage%
}

\newcommand{\apostila@drawheader}{%
    \begin{tikzpicture}[overlay, remember picture]
        \fill[primaryColor] (current page.north west) rectangle ($(current page.north east)+(0,-3.25cm)$);
        \node[anchor=north west, text=primaryColor!30, font=\Large\scshape, minimum height=3.5cm, inner xsep=1cm] at (current page.north west) {\leftmark};
        \node[anchor=north east, minimum height=2cm, inner xsep=1cm] at ($(current page.north east)+(.25cm,-.5cm)$) {\includegraphics[height=2cm]{\@unifeisymbol}};

        \fill[secondaryColor] (current page.south west) rectangle ($(current page.south east) + (0,5cm)$);
    \end{tikzpicture}
}

%% --- CABEÇALHOS GRÁFICOS COM TEXTO PARA PÁGINAS PARES E ÍMPARES ---

% Comando para o cabeçalho das páginas PARES (mostra o CAPÍTULO)
\newcommand{\apostila@drawheadereven}{%
    \begin{tikzpicture}[overlay, remember picture]
        % Barra verde
        \fill[primaryColor] (current page.north west) rectangle ($(current page.north east)+(0,-3.25cm)$);

        % Logo no canto externo (esquerda)
        \node[anchor=north west, minimum height=2cm, inner xsep=1cm] at ($(current page.north west)+(-.25cm,-.5cm)$) {\includegraphics[height=2cm]{\@unifeisymbol}};

        % Texto (título do capítulo) no canto interno (direita)
        \if@inappendix
            % Se estiver no anexo, não faz nada (ou desenha outra coisa se quiser)
        \else
            \node[
                anchor=north east,
                text=primaryColor!30,
                font=\large\sffamily\bfseries,
                minimum height=3.5cm,
                inner xsep=1cm,
                text width=0.6\textwidth,
                align=right
            ] at (current page.north east) {\nouppercase{\leftmark}};
        \fi

        % Barra amarela no rodapé
        \fill[secondaryColor] (current page.south west) rectangle ($(current page.south east) + (0,1cm)$);
    \end{tikzpicture}%
}

% Comando para o cabeçalho das páginas ÍMPARES (mostra a SEÇÃO)
\newcommand{\apostila@drawheaderodd}{%
    \begin{tikzpicture}[overlay, remember picture]
        % Barra verde
        \fill[primaryColor] (current page.north west) rectangle ($(current page.north east)+(0,-3.25cm)$);

        % Logo no canto externo (direita)
        \node[anchor=north east, minimum height=2cm, inner xsep=1cm]
        at ($(current page.north east)+(.25cm,-.5cm)$) {\includegraphics[height=2cm]{\@unifeisymbol}};

        \coordinate (capnum) at ($(current page.north west)+(2cm, -0.75cm)$);
        \if@inappendix
            % Se estiver no anexo, não faz nada (ou desenha outra coisa se quiser)
        \else
        % Texto (título da seção) no canto interno (esquerda)
        \node[
            anchor=north west,
            text=primaryColor!30,
            font=\large\sffamily\bfseries,
            minimum height=3.5cm,
            inner xsep=1cm,
            text width=0.75\textwidth,
            align=left
            ] at ($(capnum) + (0, .75cm)$) {\nouppercase{\rightmark}};
            \ifthenelse{\equal{\rightmark}{}}
            {% Do nothing, or output alternative content if rightmark is empty
            }
            {%
            \node[
                anchor=north east,
                text=primaryColor!30,
                font=\bfseries\chaptertitlenamefont,
            ] at (capnum) {\thechapter};
            }
        \fi
        % Barra amarela no rodapé
        \fill[secondaryColor] (current page.south west) rectangle ($(current page.south east) + (0,1cm)$);
    \end{tikzpicture}%
}

%% --- NOVA LÓGICA DE RODAPÉ ---
% 1. O pacote 'background' desenha a barra amarela no fundo de CADA página.
\backgroundsetup{
    angle=0,
    opacity=1,
    scale=1,
    contents={%
            \begin{tikzpicture}[remember picture, overlay]
                \fill[secondaryColor] (current page.south west) rectangle ($(current page.south east) + (0,1cm)$);
            \end{tikzpicture}%
        }
}

% 2. O fancyhdr é agora muito mais simples, contendo APENAS TEXTO.
\pagestyle{fancy}
\addtolength{\footskip}{0.6cm}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}

\if@twoside
    % Layout para frente e verso (número da página no canto externo, info no interno)
    \fancyhead[CE]{\apostila@drawheadereven} % Chama o header de pág. par no centro
    \fancyhead[CO]{\apostila@drawheaderodd}  % Chama o header de pág. ímpar no centro
    \fancyfoot[LE]{\color{primaryColor}\sffamily\thepage}
    \fancyfoot[RO]{\color{primaryColor}\sffamily\thepage}
\else
    % Layout para um lado só
    \fancyhead[C]{\apostila@drawheaderodd}
    \fancyfoot[R]{\color{primaryColor}\sffamily\thepage}
\fi

\renewcommand{\chaptermark}[1]{\markboth{#1}{}}
\renewcommand{\sectionmark}[1]{\markright{#1}}

%% --- Formatação de Capítulos (titlesec) ---
\renewcommand{\@makechapterhead}[1]{%
    % Aplica o estilo de página customizado (do fancyhdr)
    \thispagestyle{fancy}%

    % Desenha o número do capítulo no canto da página com TikZ
    \begin{tikzpicture}[overlay, remember picture]
        \node[
            anchor=north east,
            text=primaryColor!30,
            font=\chapternumberfont
        ] (number) at ($(current page.north east)+(-3cm, -1.9cm)$) {\thechapter};
        \node[
            anchor=north east,
            text=primaryColor!30,
            font=\bfseries\chaptertitlenamefont
        ] (name) at ($(number.north west)+(0, -.15cm)$) {\chaptertitlename};
    \end{tikzpicture}%

    % Bloco para o título
    \vspace*{20pt}% Espaço inicial (ajuste se necessário, era 50pt no padrão book)
    {\parindent \z@ \raggedright \normalfont
        % Define a fonte e o estilo do título
        \LARGE\color{primaryColor}\titulocapitulo
        % Imprime o título completo, com guillemots
        \guillemotleft #1\guillemotright
        % Quebra de parágrafo
        \par
    }%

    % Espaço vertical após o título
    \vspace*{20pt}%
    % Imprime o sumário local do capítulo
    {\normalfont\color{primaryColor}\small\chaptertoc}%
    \vspace*{20pt}%
}

\titlespacing*{\chapter}{0pt}{0pt}{20pt}

\let\mainmatterorig\mainmatter
\renewcommand\mainmatter{%
    \edef\temppagenumber{\arabic{page}}%
    \mainmatterorig
    \setcounter{page}{\temppagenumber}%
}

% Correção para os cabeçalhos após capítulos
\newif\if@inappendix
\@inappendixfalse

% Salva o comando original
\let\origappendix\appendix

% Redefine para chamar o original E mudar a nossa bandeira para verdadeiro
\renewcommand{\appendix}{%
  \origappendix%
  \global\@inappendixtrue%
  \renewcommand{\leftmark}{}
  \renewcommand{\rightmark}{}
}

\endinput
