% 3. Cria o comando \source para ficar ABAIXO e ALINHADO À ESQUERDA
% Define um macro auxiliar `\apostila@captionfont` que será
% inicializado em \AtBeginDocument para espelhar a fonte das captions.

% --- Variáveis de suporte ---
\providecommand{\apostila@captionfont}{\small}
% --- 1. Cria a variável para armazenar a largura da imagem ---
\newlength{\LastGraphicWidth}
% --- 2. Redefine o \includegraphics para medir a imagem automaticamente ---
\let\OldIncludegraphics\includegraphics
\renewcommand{\includegraphics}[2][]{%
    % Insere a imagem original
    \OldIncludegraphics[#1]{#2}%
    % Mede a largura da imagem recém inserida e salva em \LastGraphicWidth
    \settowidth{\LastGraphicWidth}{\OldIncludegraphics[#1]{#2}}%
}
\newcommand{\source}[1]{%
    \par\vspace{2pt}{\apostila@captionfont%
        \IfStrEq{#1}{}{\def\textoFinal{Autoria própria.}}{\def\textoFinal{#1\IfEndWith{#1}{.}{}{.}}}%
        \ifdim\LastGraphicWidth=0pt \setlength{\LastGraphicWidth}{\linewidth} \fi%
        \makebox[\linewidth][c]{\makebox[\LastGraphicWidth][l]{\textbf{Fonte:}~\textoFinal}}\par}
    \setlength{\LastGraphicWidth}{0pt}%
}
