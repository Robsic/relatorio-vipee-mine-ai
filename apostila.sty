% Verifica se está compilando com XeTeX ou LuaTeX.
% --- Lógica Condicional de Fonte ---
\ifLuaTeX
    % --- Bloco para LuaLaTeX ---
    \PackageInfo{apostila}{Motor LuaTeX detectado. Usando fontspec.}
    \RequirePackage{fontspec}

    % 1. Define as famílias de fontes principais — usar Heuristica como padrão
    \setmainfont{Heuristica}[
        Path=./Fontes/,
        Extension=.otf,
        UprightFont=*-Regular,
        BoldFont=*-Bold,
        ItalicFont=*-Italic
    ]
    % 2. Define a família de fontes para sans-serif
    \setsansfont{GoogleSans}[
        Path=./Fontes/,
        Extension=.ttf,
        UprightFont=*-Regular,
        BoldFont=*-Bold,
        ItalicFont=*-Italic
    ]
    % 3. Define a família de fontes para monoespaçado
    \setmonofont{SourceCodePro}[
        Path      = ./Fontes/,
        Extension = .ttf,
        UprightFont = *-Regular,
        BoldFont    = *-Bold,
        ItalicFont  = *-Italic
    ]

    % 4. Usa a opção do pacote para definir a família PADRÃO
    \if@apostila@roman
        \renewcommand{\familydefault}{\rmdefault}
    \else
        \renewcommand{\familydefault}{\sfdefault}
    \fi

    % 5. Define as fontes para elementos especiais
    \newfontfamily\titulocapitulo{Cinzel}[
        Path        = ./Fontes/,
        Extension   = .ttf,
        UprightFont = *-Regular,
        BoldFont    = *-Bold
    ]
    \newfontfamily\numerocapitulo{Cinzel-Bold.ttf}[Path=./Fontes/]
    \newfontfamily\lettrinefont{EBGaramond-Regular.ttf}[Path=./Fontes/]
\else
    \ifXeTeX
        % --- Bloco para XeLaTeX (mesma lógica do LuaLaTeX) ---
        \PackageInfo{apostila}{Motor XeTeX detectado. Usando fontspec.}
        \RequirePackage{fontspec}
        % Usar Heuristica como padrão de forma estável
        \setmainfont{Heuristica}[
            Path=./Fontes/,
            Extension=.otf,
            UprightFont=*-Regular,
            BoldFont=*-Bold,
            ItalicFont=*-Italic
        ]
        \setsansfont{SourceSans3}[
            Path=./Fontes/,
            Extension=.otf,
            UprightFont=*-Regular,
            BoldFont=*-Bold,
            ItalicFont=*-Italic
        ]
        \setmonofont{SourceCodePro}[
            Path      = ./Fontes/,
            Extension = .ttf,
            UprightFont = *-Regular,
            BoldFont    = *-Bold,
            ItalicFont  = *-Italic
        ]
        \if@apostila@roman
            \renewcommand{\familydefault}{\rmdefault}
        \else
            \renewcommand{\familydefault}{\sfdefault}
        \fi

        \newfontfamily\titulocapitulo{Cinzel}[
            Path        = ./Fontes/,
            Extension   = .ttf,
            UprightFont = *-Regular,
            BoldFont    = *-Bold
        ]
        \newfontfamily\numerocapitulo{Cinzel-Bold.ttf}[Path=./Fontes/]
        \newfontfamily\lettrinefont{EBGaramond-Regular.ttf}[Path=./Fontes/]
    \else
        % --- Bloco para pdfLaTeX (fallback) ---
        \PackageInfo{apostila}{Motor pdfLaTeX detectado. Usando pacotes legados.}
        \RequirePackage[T1]{fontenc}

        \if@apostila@roman
            % Usar o pacote 'libertinus' no fallback pdfLaTeX
            \RequirePackage{libertinus}
        \else
            \RequirePackage{sourcesanspro}
        \fi
        \RequirePackage{inconsolata}
        \RequirePackage{ebgaramond}

        \newcommand{\titulocapitulo}{\rmfamily\selectfont}
        \newcommand{\numerocapitulo}{\bfseries\rmfamily\selectfont}
        \newcommand{\lettrinefont}{\fontfamily{EBGaramond-LF}\selectfont}
    \fi
\fi % Fim da lógica condicional

